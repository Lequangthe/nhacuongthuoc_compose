    <!--About Strings-->
    <string name="simpillAboutParagraph_1">Simpill là ứng dụng nhắc uống thuốc miễn phí và mã nguồn mở, không có trình theo dõi, quảng cáo phiền nhiễu hay yêu cầu quyền hạn không cần thiết.</string>
    <string name="simpillAboutParagraph_2">Simpill là ứng dụng hoàn toàn miễn phí và không tạo ra doanh thu từ quảng cáo hay bán dữ liệu.\n\nNếu bạn muốn ủng hộ Simpill và sự phát triển trong tương lai, có một số lựa chọn quyên góp sau:</string>

